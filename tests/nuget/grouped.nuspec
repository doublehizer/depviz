<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Demo.Grouped</id>
    <version>1.2.10</version>
    <dependencies>
      <group targetFramework=".NETFramework4.6.2">
        <dependency id="Old.Framework" version="1.0.0" />
      </group>
      <group targetFramework="net6.0">
        <dependency id="For.Net6" version="6.0.0" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="Logging" version="8.0.0" exclude="Build" />
        <dependency id="Options" version="[8.0.0, 9.0.0)" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="Too.New" version="9.0.0" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="For.Standard" version="2.0.0" />
      </group>
    </dependencies>
  </metadata>
</package>
